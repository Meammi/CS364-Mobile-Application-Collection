<?xml version="1.0" encoding="utf-8"?>
<!-- Keep the same view ids as layout-land/activity_review.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ReviewActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/navigate_up"
        app:navigationIcon="?attr/homeAsUpIndicator">

        <Chronometer
            android:id="@+id/timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_timer"
            android:contentDescription="@string/study_time"
            android:drawablePadding="6dp"
            android:drawableStart="@drawable/ic_timer"
            android:drawableTint="?attr/colorOnSecondaryContainer"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSecondaryContainer" />
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- rest of the header band: "Card 3 of 12" + progress -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorHeader"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/progressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnHeader" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressBar"
            style="@style/ReviewProgress" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/practiceBadge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/practice_badge"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorTertiary"
            android:visibility="gone" />

        <!-- keeps the Mode button at the end when the badge is hidden -->
        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="0.001" />

        <Button
            android:id="@+id/modeButton"
            style="@style/Widget.Lilearn.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/mode_original"
            app:icon="@drawable/ic_swap"
            app:iconSize="18dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/flashCard"
            style="@style/Widget.Lilearn.ListCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/noticeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/choice_notice"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/frontText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:textAppearance="?attr/textAppearanceHeadlineLarge" />

                <TextView
                    android:id="@+id/resultText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_horizontal"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:visibility="gone" />

                <!-- line with a small lily between Front and Back -->
                <LinearLayout
                    android:id="@+id/answerDivider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="?attr/colorOutlineVariant" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_lily_mark" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="?attr/colorOutlineVariant" />
                </LinearLayout>

                <TextView
                    android:id="@+id/backText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:lineSpacingMultiplier="1.15"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </ScrollView>

    <LinearLayout
        android:id="@+id/optionsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/option0"
            style="@style/Widget.Lilearn.Option" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/option1"
            style="@style/Widget.Lilearn.Option" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/option2"
            style="@style/Widget.Lilearn.Option" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/option3"
            style="@style/Widget.Lilearn.Option" />
    </LinearLayout>

    <Button
        android:id="@+id/showAnswerButton"
        style="@style/Widget.Lilearn.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/show_answer" />

    <LinearLayout
        android:id="@+id/gradeLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/gradeAgain"
            style="@style/GradeButton.Again"
            android:layout_marginEnd="4dp"
            android:text="@string/grade_again" />

        <Button
            android:id="@+id/gradeHard"
            style="@style/GradeButton.Hard"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="@string/grade_hard" />

        <Button
            android:id="@+id/gradeGood"
            style="@style/GradeButton.Good"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="@string/grade_good" />

        <Button
            android:id="@+id/gradeEasy"
            style="@style/GradeButton.Easy"
            android:layout_marginStart="4dp"
            android:text="@string/grade_easy" />
    </LinearLayout>

    <Button
        android:id="@+id/nextButton"
        style="@style/Widget.Lilearn.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/next"
        android:visibility="gone" />
</LinearLayout>
