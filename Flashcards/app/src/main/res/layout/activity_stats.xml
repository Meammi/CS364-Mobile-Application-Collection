<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".StatsActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/navigate_up"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/statistics" />

    <!-- deck filter, inside the header band -->
    <Spinner
        android:id="@+id/deckFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorHeader"
        android:minHeight="48dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        android:theme="@style/ThemeOverlay.Lilearn.Header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- totals: 2 x 2 tiles -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <include
                    android:id="@+id/tileToday"
                    layout="@layout/item_stat_tile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/tileAllTime"
                    layout="@layout/item_stat_tile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <include
                    android:id="@+id/tileStreak"
                    layout="@layout/item_stat_tile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/tileAgain"
                    layout="@layout/item_stat_tile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <TextView
                style="@style/StatsHeader"
                android:text="@string/stats_last_7_days" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Lilearn.ListCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/stats_cards_reviewed"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <LinearLayout
                        android:id="@+id/chartCards"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Lilearn.ListCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/stats_minutes"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <LinearLayout
                        android:id="@+id/chartMinutes"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/StatsHeader"
                android:text="@string/stats_card_states" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Lilearn.ListCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- one bar split New / Learning / Mature (weights set in code) -->
                    <LinearLayout
                        android:id="@+id/stateBar"
                        android:layout_width="match_parent"
                        android:layout_height="14dp"
                        android:background="@drawable/bg_state_bar"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/stateNewSeg"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:background="?attr/colorOutline" />

                        <View
                            android:id="@+id/stateLearningSeg"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:background="?attr/colorSecondary" />

                        <View
                            android:id="@+id/stateMatureSeg"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:background="?attr/colorTertiary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <LinearLayout style="@style/StatsLegend">

                            <TextView
                                style="@style/StatsLegendLabel"
                                android:text="@string/state_new"
                                app:drawableStartCompat="@drawable/swatch_new" />

                            <TextView
                                android:id="@+id/stateNewCount"
                                style="@style/StatsLegendValue" />
                        </LinearLayout>

                        <LinearLayout style="@style/StatsLegend">

                            <TextView
                                style="@style/StatsLegendLabel"
                                android:text="@string/state_learning"
                                app:drawableStartCompat="@drawable/swatch_learning" />

                            <TextView
                                android:id="@+id/stateLearningCount"
                                style="@style/StatsLegendValue" />
                        </LinearLayout>

                        <LinearLayout style="@style/StatsLegend">

                            <TextView
                                style="@style/StatsLegendLabel"
                                android:text="@string/state_mature"
                                app:drawableStartCompat="@drawable/swatch_mature" />

                            <TextView
                                android:id="@+id/stateMatureCount"
                                style="@style/StatsLegendValue" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/stats_states_hint"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/StatsHeader"
                android:text="@string/stats_history" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Lilearn.ListCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/historyEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:text="@string/stats_no_sessions"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/historyList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
