<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Flashcards" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <!-- Lily Gothic. Colours switch day/night through values-night/colors.xml. -->
    <style name="Theme.Flashcards" parent="Base.Theme.Flashcards">
        <item name="colorPrimary">@color/lily_primary</item>
        <item name="colorOnPrimary">@color/lily_on_primary</item>
        <item name="colorPrimaryContainer">@color/lily_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/lily_on_primary_container</item>
        <item name="colorSecondary">@color/lily_secondary</item>
        <item name="colorOnSecondary">@color/lily_on_secondary</item>
        <item name="colorSecondaryContainer">@color/lily_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/lily_on_secondary_container</item>
        <item name="colorTertiary">@color/lily_tertiary</item>
        <item name="colorOnTertiary">@color/lily_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/lily_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/lily_on_tertiary_container</item>
        <item name="colorError">@color/lily_error</item>
        <item name="colorOnError">@color/lily_on_error</item>
        <item name="colorErrorContainer">@color/lily_error_container</item>
        <item name="colorOnErrorContainer">@color/lily_on_error_container</item>
        <item name="android:colorBackground">@color/lily_background</item>
        <item name="colorOnBackground">@color/lily_on_background</item>
        <item name="colorSurface">@color/lily_surface</item>
        <item name="colorOnSurface">@color/lily_on_surface</item>
        <item name="colorSurfaceVariant">@color/lily_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/lily_on_surface_variant</item>
        <item name="colorOutline">@color/lily_outline</item>
        <item name="colorOutlineVariant">@color/lily_outline_variant</item>
        <item name="colorSurfaceInverse">@color/lily_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/lily_inverse_on_surface</item>
        <item name="colorPrimaryInverse">@color/lily_inverse_primary</item>
        <item name="colorSurfaceContainerLowest">@color/lily_surface_lowest</item>
        <item name="colorSurfaceContainerLow">@color/lily_surface_low</item>
        <item name="colorSurfaceContainer">@color/lily_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/lily_surface_high</item>
        <item name="colorSurfaceContainerHighest">@color/lily_surface_highest</item>
        <item name="colorSurfaceDim">@color/lily_surface_dim</item>
        <item name="colorSurfaceBright">@color/lily_surface_bright</item>

        <item name="colorSuccess">@color/lily_success</item>
        <item name="colorOnSuccess">@color/lily_on_success</item>
        <item name="colorSuccessContainer">@color/lily_success_container</item>
        <item name="colorOnSuccessContainer">@color/lily_on_success_container</item>
        <item name="colorHeader">@color/lily_header</item>
        <item name="colorOnHeader">@color/lily_on_header</item>
        <item name="colorOnHeaderVariant">@color/lily_on_header_variant</item>
        <item name="colorHeaderAccent">@color/lily_header_accent</item>
        <item name="colorHeaderTrack">@color/lily_header_track</item>

        <!-- the header band reaches under the status bar, so light icons in both themes -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="toolbarStyle">@style/Widget.Lilearn.Toolbar</item>

        <item name="android:fontFamily">@font/plex_sans_thai</item>
        <item name="fontFamily">@font/plex_sans_thai</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.Lilearn.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.Lilearn.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.Lilearn.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Lilearn.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Lilearn.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Lilearn.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Lilearn.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Lilearn.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Lilearn.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Lilearn.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Lilearn.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Lilearn.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Lilearn.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Lilearn.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Lilearn.LabelSmall</item>
    </style>

    <!-- Toolbars: plum header band on every screen -->
    <style name="Widget.Lilearn.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/colorHeader</item>
        <item name="titleTextColor">?attr/colorOnHeader</item>
        <item name="subtitleTextColor">?attr/colorOnHeaderVariant</item>
        <item name="navigationIconTint">?attr/colorOnHeader</item>
        <item name="titleTextAppearance">@style/TextAppearance.Lilearn.ToolbarTitle</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.Lilearn.Header</item>
    </style>

    <!-- Buttons: 12dp corners, 52dp tall (Gothic mockup) -->
    <style name="Widget.Lilearn.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">52dp</item>
    </style>
    <style name="Widget.Lilearn.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
    </style>
    <style name="Widget.Lilearn.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <!-- a tappable row in a list (Cards, Decks): near-white, thin outline, 12dp corners -->
    <style name="Widget.Lilearn.ListCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLowest</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="cardCornerRadius">12dp</item>
    </style>

    <!-- serif name of a Card or Deck in a list -->
    <style name="TextAppearance.Lilearn.ListTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/noto_serif_semibold</item>
        <item name="fontFamily">@font/noto_serif_semibold</item>
        <item name="android:textSize">17sp</item>
    </style>

    <!-- Review -->
    <style name="ReviewProgress">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="indicatorColor">?attr/colorOnHeaderVariant</item>
        <item name="trackColor">?attr/colorHeaderTrack</item>
        <item name="trackCornerRadius">2dp</item>
    </style>
    <style name="Widget.Lilearn.Option" parent="Widget.Lilearn.Button.Outlined">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:maxLines">3</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="iconGravity">end</item>
    </style>
    <!-- Grade buttons: one per Grade, equal width in a row -->
    <style name="GradeButton.Again" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:maxLines">1</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textColor">?attr/colorError</item>
        <item name="strokeColor">?attr/colorError</item>
    </style>
    <style name="GradeButton.Hard" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:maxLines">1</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
    </style>
    <style name="GradeButton.Good" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:maxLines">1</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="cornerRadius">12dp</item>
    </style>
    <style name="GradeButton.Easy" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:maxLines">1</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">?attr/colorTertiaryContainer</item>
        <item name="android:textColor">?attr/colorOnTertiaryContainer</item>
    </style>

    <!-- Statistics -->
    <style name="StatsHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Lilearn.SectionTitle</item>
    </style>
    <style name="TextAppearance.Lilearn.SectionTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/noto_serif_semibold</item>
        <item name="fontFamily">@font/noto_serif_semibold</item>
        <item name="android:textSize">20sp</item>
    </style>
    <style name="TextAppearance.Lilearn.StatNumber" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/noto_serif_semibold</item>
        <item name="fontFamily">@font/noto_serif_semibold</item>
    </style>
    <style name="StatsLegend">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="StatsLegendLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textAppearance">?attr/textAppearanceBodySmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="StatsLegendValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textAppearance">@style/TextAppearance.Lilearn.SectionTitle</item>
    </style>

    <!-- text fields: 12dp corners on a near-white box -->
    <style name="Widget.Lilearn.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxBackgroundColor">?attr/colorSurfaceContainerLowest</item>
    </style>

    <!-- menu and overflow icons inside the band -->
    <style name="ThemeOverlay.Lilearn.Header" parent="">
        <item name="colorControlNormal">@color/lily_on_header</item>
        <item name="colorOnSurface">@color/lily_on_header</item>
        <item name="colorOnSurfaceVariant">@color/lily_on_header_variant</item>
    </style>

    <style name="TextAppearance.Lilearn.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/noto_serif_semibold</item>
        <item name="fontFamily">@font/noto_serif_semibold</item>
    </style>

    <!-- Type: Noto Serif for Display/Headline (Front word, titles), Plex Sans Thai for the rest.
         Thai text in serif styles falls back to the system Thai font. -->
    <style name="TextAppearance.Lilearn.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">@font/noto_serif_semibold</item>
        <item name="fontFamily">@font/noto_serif_semibold</item>
    </style>
    <style name="TextAppearance.Lilearn.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:fontFamily">@font/noto_serif_semibold</item>
        <item name="fontFamily">@font/noto_serif_semibold</item>
    </style>
    <style name="TextAppearance.Lilearn.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/noto_serif_semibold</item>
        <item name="fontFamily">@font/noto_serif_semibold</item>
    </style>
    <style name="TextAppearance.Lilearn.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/noto_serif_semibold</item>
        <item name="fontFamily">@font/noto_serif_semibold</item>
    </style>
    <style name="TextAppearance.Lilearn.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/noto_serif_semibold</item>
        <item name="fontFamily">@font/noto_serif_semibold</item>
    </style>
    <style name="TextAppearance.Lilearn.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/noto_serif_semibold</item>
        <item name="fontFamily">@font/noto_serif_semibold</item>
    </style>
    <style name="TextAppearance.Lilearn.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/plex_sans_thai</item>
        <item name="fontFamily">@font/plex_sans_thai</item>
        <item name="android:textFontWeight">600</item>
    </style>
    <style name="TextAppearance.Lilearn.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/plex_sans_thai</item>
        <item name="fontFamily">@font/plex_sans_thai</item>
        <item name="android:textFontWeight">600</item>
    </style>
    <style name="TextAppearance.Lilearn.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/plex_sans_thai</item>
        <item name="fontFamily">@font/plex_sans_thai</item>
        <item name="android:textFontWeight">600</item>
    </style>
    <style name="TextAppearance.Lilearn.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/plex_sans_thai</item>
        <item name="fontFamily">@font/plex_sans_thai</item>
    </style>
    <style name="TextAppearance.Lilearn.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/plex_sans_thai</item>
        <item name="fontFamily">@font/plex_sans_thai</item>
    </style>
    <style name="TextAppearance.Lilearn.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/plex_sans_thai</item>
        <item name="fontFamily">@font/plex_sans_thai</item>
    </style>
    <style name="TextAppearance.Lilearn.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/plex_sans_thai</item>
        <item name="fontFamily">@font/plex_sans_thai</item>
        <item name="android:textFontWeight">600</item>
    </style>
    <style name="TextAppearance.Lilearn.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/plex_sans_thai</item>
        <item name="fontFamily">@font/plex_sans_thai</item>
        <item name="android:textFontWeight">500</item>
    </style>
    <style name="TextAppearance.Lilearn.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/plex_sans_thai</item>
        <item name="fontFamily">@font/plex_sans_thai</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <!-- section title on the Settings screen (also used on Statistics) -->
    <style name="SettingsHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">?attr/colorSecondary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- header above a rounded group (the screen already has side padding) -->
    <style name="SettingsHeader.Group">
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
    </style>

    <!-- one rounded group of Settings rows -->
    <style name="SettingsGroup" parent="Widget.Material3.CardView.Outlined">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLowest</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="cardCornerRadius">12dp</item>
    </style>

    <style name="SettingsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="dividerColor">?attr/colorOutlineVariant</item>
    </style>
</resources>
