<?xml version="1.0" encoding="utf-8"?>
<!-- Keep the same view ids as layout/activity_review.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ReviewActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/navigate_up"
        app:navigationIcon="?attr/homeAsUpIndicator">

        <Chronometer
            android:id="@+id/timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_timer"
            android:contentDescription="@string/study_time"
            android:drawablePadding="6dp"
            android:drawableStart="@drawable/ic_timer"
            android:drawableTint="?attr/colorOnSecondaryContainer"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSecondaryContainer" />
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- rest of the header band, one row to save height -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorHeader"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/progressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnHeader" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressBar"
            style="@style/ReviewProgress"
            android:layout_width="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- left: the Card -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="8dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/practiceBadge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/practice_badge"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorTertiary"
                    android:visibility="gone" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/flashCard"
                    style="@style/Widget.Lilearn.ListCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/noticeText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="@string/choice_notice"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/frontText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:textAppearance="?attr/textAppearanceHeadlineLarge" />

                        <TextView
                            android:id="@+id/resultText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_horizontal"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/answerDivider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1"
                                android:background="?attr/colorOutlineVariant" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginStart="10dp"
                                android:layout_marginEnd="10dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_lily_mark" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1"
                                android:background="?attr/colorOutlineVariant" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/backText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:lineSpacingMultiplier="1.15"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <!-- right: Mode, Options or Grades -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <Button
                    android:id="@+id/modeButton"
                    style="@style/Widget.Lilearn.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:minHeight="44dp"
                    android:text="@string/mode_original"
                    app:icon="@drawable/ic_swap"
                    app:iconSize="18dp" />

                <LinearLayout
                    android:id="@+id/optionsLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/option0"
                        style="@style/Widget.Lilearn.Option" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/option1"
                        style="@style/Widget.Lilearn.Option" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/option2"
                        style="@style/Widget.Lilearn.Option" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/option3"
                        style="@style/Widget.Lilearn.Option" />
                </LinearLayout>

                <Button
                    android:id="@+id/showAnswerButton"
                    style="@style/Widget.Lilearn.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/show_answer" />

                <!-- Grades as 2 x 2 -->
                <LinearLayout
                    android:id="@+id/gradeLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/gradeAgain"
                            style="@style/GradeButton.Again"
                            android:layout_marginEnd="4dp"
                            android:text="@string/grade_again" />

                        <Button
                            android:id="@+id/gradeHard"
                            style="@style/GradeButton.Hard"
                            android:layout_marginStart="4dp"
                            android:text="@string/grade_hard" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/gradeGood"
                            style="@style/GradeButton.Good"
                            android:layout_marginEnd="4dp"
                            android:text="@string/grade_good" />

                        <Button
                            android:id="@+id/gradeEasy"
                            style="@style/GradeButton.Easy"
                            android:layout_marginStart="4dp"
                            android:text="@string/grade_easy" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/nextButton"
                    style="@style/Widget.Lilearn.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/next"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
